# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all text files (cross-platform compatibility per contract)
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.env text eol=lf
*.env.example text eol=lf